---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import TestimonialSlider from "@/components/react/TestimonialSlider";
import ContactForm from "@/components/react/ContactForm";
import { site, unsplash, insurances, testimonials } from "@/data/site";
import { clinics, treatmentsAt, nearest, miles, consultPhoto } from "@/data/treatments";

export async function getStaticPaths() {
  const all = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
  return clinics.map((clinic) => ({ params: { city: clinic.slug }, props: { clinic, all } }));
}
const { clinic, all } = Astro.props;
const c = clinic;
const treatments = treatmentsAt(all, c.slug);
const near = nearest(c, clinics, 4);
const phoneHref = `tel:${c.phone.replace(/-/g, "")}`;
const dir = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(`${c.address}, ${c.zip}`)}`;
const reasons = all.map((s) => s.data.title);
const embed = `https://www.google.com/maps?q=${encodeURIComponent(`Neuhaus Foot & Ankle, ${c.address}, ${c.zip}`)}&z=15&output=embed`;
const cityNames = clinics.map((x) => x.city);

const title = `Podiatrist in ${c.city}, TN | Foot & Ankle Doctors`;
const description = `Neuhaus Foot & Ankle in ${c.city}, TN. Podiatrists for kids and adults. ${c.address}, ${c.zip}. Call ${c.phone}. See conditions we treat, map, and insurance.`;

const faqs = [
  { q: `Where is the Neuhaus Foot & Ankle clinic in ${c.city}?`, a: `Our ${c.city} clinic is at ${c.address}, ${c.zip}. Use the map on this page for directions.` },
  { q: `How do I make an appointment in ${c.city}?`, a: `Call ${c.phone} or use the appointment form on this page. Tell us what is bothering your feet and we will find a time for you.` },
  { q: `What foot and ankle problems do you treat in ${c.city}?`, a: `Our ${c.city} clinic treats ${treatments.length} groups of foot and ankle conditions, from heel and arch pain to bunions, ankle injuries, arthritis, fractures, diabetic wound care, and children's foot care. See the full list above.` },
  { q: `Do you see children at the ${c.city} clinic?`, a: `Yes. Our podiatrists care for kids and adults.` },
  { q: `Which insurance plans do you accept in ${c.city}?`, a: `We work with most major plans, including Medicare and TennCare. Call ${c.phone} and we will check your coverage before your visit.` },
];
const ld = JSON.stringify([
  {
    "@context": "https://schema.org", "@type": "MedicalClinic", name: `Neuhaus Foot & Ankle, ${c.city}`,
    medicalSpecialty: "Podiatric", telephone: c.phone,
    address: { "@type": "PostalAddress", streetAddress: c.address, addressLocality: c.city, addressRegion: "TN", postalCode: c.zip.split(" ").pop(), addressCountry: "US" },
    geo: { "@type": "GeoCoordinates", latitude: c.lat, longitude: c.lng },
  },
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) },
]);
---
<BaseLayout title={title} description={description}>
  <!-- Hero -->
  <section class="relative isolate overflow-hidden bg-navy-950 pb-28 pt-40 text-white md:pb-36 md:pt-48">
    <img src={unsplash("1711466093648-1adfe1664678", 2000)} alt="" class="absolute inset-0 -z-10 h-full w-full object-cover opacity-30" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-navy-950 via-navy-950/75 to-navy-950/40"></div>
    <div class="wrap grid items-end gap-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="eyebrow !text-gold" data-reveal>Neuhaus Foot &amp; Ankle · {c.city}</p>
        <h1 class="mt-5 font-display text-[clamp(2.8rem,6.5vw,5.4rem)] leading-[1] text-white" data-reveal="0.05">
          Podiatrist in <em class="text-sky-soft">{c.city}, TN.</em>
        </h1>
        <p class="mt-6 max-w-xl text-lg text-white/75" data-reveal="0.1">
          Expert foot and ankle care for kids and adults, close to home in {c.city}. Find out what we treat, see the map, and book a visit.
        </p>
        <div class="mt-9 flex flex-wrap gap-3" data-reveal="0.15">
          <a href="#book" class="btn-gold">Request an appointment</a>
          <a href={phoneHref} class="btn-ghost">Call {c.phone}</a>
        </div>
      </div>
      <div class="lg:col-span-5" data-reveal="0.2">
        <div class="rounded-3xl border border-white/15 bg-white/10 p-7 backdrop-blur-md">
          <p class="text-[0.72rem] font-semibold uppercase tracking-[0.22em] text-gold">Our {c.city} clinic</p>
          <p class="mt-3 font-display text-[1.7rem] leading-snug text-white">{c.address}<br />{c.zip}</p>
          <div class="mt-5 flex flex-wrap gap-2">
            <a href={dir} target="_blank" rel="noopener" class="btn-gold !px-5 !py-2.5 !text-[0.85rem]">Get directions</a>
            <a href="#map" class="btn-ghost !px-5 !py-2.5 !text-[0.85rem]">View map</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Facts strip -->
  <section class="relative z-10 -mt-12">
    <div class="wrap">
      <ul class="grid overflow-hidden rounded-2xl bg-white shadow-[0_30px_60px_-30px_rgba(7,31,48,.45)] sm:grid-cols-2 lg:grid-cols-4">
        {[
          ["Call us", c.phone, phoneHref],
          ["Visit us", c.address, dir],
          ["We treat", `${treatments.length} condition groups`, "#conditions"],
          ["Insurance", "Most major plans", "#insurance"],
        ].map(([k, v, h], i) => (
          <li class="border-line sm:border-r lg:last:border-r-0" data-reveal={String(i * 0.06)}>
            <a href={h} class="group block px-6 py-5 transition-colors hover:bg-mist">
              <span class="text-[0.7rem] font-semibold uppercase tracking-[0.2em] text-sky">{k}</span>
              <span class="mt-1 flex items-center justify-between font-display text-[1.25rem] leading-snug text-navy-900">{v}<span aria-hidden="true" class="text-sky transition-transform group-hover:translate-x-1">&rarr;</span></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Map -->
  <section id="map" class="py-20 md:py-24">
    <div class="wrap">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <div>
          <p class="eyebrow" data-reveal>Find us</p>
          <h2 class="heading-xl mt-4 !text-[clamp(2.2rem,4vw,3.4rem)]" data-reveal="0.05">Our clinic in <em class="text-sky">{c.city}.</em></h2>
        </div>
        <p class="max-w-sm text-slate" data-reveal="0.1">Zoom in to see the streets around our clinic, or tap Get directions to open your phone's maps.</p>
      </div>

      <div class="mt-10 grid gap-6 lg:grid-cols-12" data-reveal="0.1">
        <div class="relative lg:col-span-8">
          <iframe title={`Map of the ${c.city} clinic`} src={embed} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen class="block h-[420px] w-full rounded-[1.75rem] border-0 md:h-[560px]"></iframe>
        </div>
        <aside class="flex flex-col gap-4 lg:col-span-4">
          <div class="rounded-[1.75rem] bg-navy p-8 text-white">
            <p class="text-[0.72rem] font-semibold uppercase tracking-[0.22em] text-gold">{c.city} clinic</p>
            <p class="mt-3 font-display text-[1.9rem] leading-tight text-white">{c.address}</p>
            <p class="text-white/70">{c.zip}</p>
            <a href={phoneHref} class="mt-5 block font-display text-[2rem] text-gold hover:underline">{c.phone}</a>
            <div class="mt-6 flex flex-wrap gap-2">
              <a href={dir} target="_blank" rel="noopener" class="btn-gold !px-5 !py-2.5 !text-[0.85rem]">Get directions</a>
              <a href="#book" class="btn-ghost !px-5 !py-2.5 !text-[0.85rem]">Book a visit</a>
            </div>
          </div>
          <div class="rounded-[1.75rem] bg-mist p-8">
            <p class="text-[0.72rem] font-semibold uppercase tracking-[0.22em] text-sky">Closest to {c.city}</p>
            <ul class="mt-3 divide-y divide-line">
              {near.map((n) => (
                <li><a href={`/locations/${n.slug}`} class="flex items-center justify-between py-3 font-medium text-navy-900 hover:text-sky">{n.city}<span class="text-[0.85rem] text-slate">{miles(c, n)} mi &rarr;</span></a></li>
              ))}
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Conditions -->
  <section id="conditions" class="bg-mist py-20 md:py-24">
    <div class="wrap">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow">Conditions we treat</p>
        <h2 class="heading-xl mt-4 !text-[clamp(2.2rem,4vw,3.4rem)]">Foot and ankle care in <em class="text-sky">{c.city}.</em></h2>
        <p class="mt-4 text-slate">Pick a condition to see how we treat it at our {c.city} clinic.</p>
      </div>
      <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {treatments.map((s, i) => (
          <li data-reveal={String((i % 3) * 0.07)}>
            <a href={`/services/${s.id}/${c.slug}`} class="group relative block aspect-[4/3] overflow-hidden rounded-2xl bg-navy-950">
              <img src={unsplash(s.data.image, 700, 520)} alt="" loading="lazy" class="absolute inset-0 h-full w-full object-cover opacity-80 transition duration-700 group-hover:scale-105 group-hover:opacity-60" />
              <div class="absolute inset-0 bg-gradient-to-t from-navy-950 via-navy-950/30 to-transparent"></div>
              <div class="absolute inset-x-0 bottom-0 p-6 text-white">
                <p class="font-display text-[1.7rem] leading-tight text-white">{s.data.title}</p>
                <p class="mt-1 flex items-center gap-2 text-[0.85rem] text-white/80">Treatment in {c.city}<span aria-hidden="true" class="text-gold transition-transform group-hover:translate-x-1">&rarr;</span></p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Why us -->
  <section class="py-20 md:py-24">
    <div class="wrap grid gap-12 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-5" data-reveal>
        <div class="gable relative aspect-[4/5] overflow-hidden bg-mist">
          <img src={unsplash(consultPhoto, 1000, 1250)} alt="A podiatrist listening to a patient" loading="lazy" class="h-full w-full object-cover" />
        </div>
      </div>
      <div class="lg:col-span-7 lg:pl-8">
        <p class="eyebrow" data-reveal>Why {c.city} patients choose us</p>
        <h2 class="heading-xl mt-4 !text-[clamp(2.2rem,4vw,3.4rem)]" data-reveal="0.05">Care that fits <em class="text-sky">your life.</em></h2>
        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          {[
            ["17", "podiatrists and foot & ankle surgeons on our team"],
            ["16", "clinics across Middle Tennessee, including ours in " + c.city],
            ["Kids & adults", "every age is welcome at the " + c.city + " clinic"],
            ["Less surgery", "many problems get better without it"],
          ].map(([n, l], i) => (
            <div class="rounded-2xl border border-line bg-white p-6" data-reveal={String(i * 0.06)}>
              <p class="font-display text-[2.4rem] leading-none text-navy">{n}</p>
              <p class="mt-2 text-[0.92rem] text-slate">{l}</p>
            </div>
          ))}
        </div>
        <a href="/doctors" class="link-arrow mt-8">Meet our providers <span aria-hidden="true">&rarr;</span></a>
      </div>
    </div>
  </section>

  <!-- Insurance -->
  <section id="insurance" class="bg-navy-950 py-20 text-white md:py-24">
    <div class="wrap">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow !text-gold">Insurance</p>
        <h2 class="heading-xl mt-4 !text-[clamp(2.2rem,4vw,3.4rem)] !text-white">Plans we accept in <em class="text-sky-soft">{c.city}.</em></h2>
        <p class="mt-4 text-white/70">Call <a href={phoneHref} class="font-semibold text-gold hover:underline">{c.phone}</a> and we will check your coverage before your visit.</p>
      </div>
      <ul class="mt-10 flex flex-wrap gap-2.5" data-reveal="0.1">
        {insurances.map((n) => <li class="rounded-full border border-white/15 px-4 py-2 text-[0.9rem] text-white/85 transition-colors hover:border-gold hover:text-gold">{n}</li>)}
        <li class="rounded-full bg-gold px-4 py-2 text-[0.9rem] font-semibold text-navy-950">And many more</li>
      </ul>
    </div>
  </section>

  <!-- Reviews -->
  <section class="py-20 md:py-24">
    <div class="wrap grid items-center gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4" data-reveal>
        <p class="eyebrow">Reviews</p>
        <h2 class="heading-xl mt-4 !text-[clamp(2.2rem,4vw,3.4rem)]">Patients <em class="text-sky">love</em> the care.</h2>
        <p class="mt-4 text-slate">Reviews from Google, Yelp &amp; Facebook.</p>
      </div>
      <div class="lg:col-span-8"><TestimonialSlider client:visible items={testimonials} /></div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-mist py-20 md:py-24">
    <div class="wrap grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4" data-reveal>
        <p class="eyebrow">FAQ</p>
        <h2 class="heading-xl mt-4 !text-[clamp(2rem,3.4vw,3rem)]">Visiting our {c.city} <em class="text-sky">clinic.</em></h2>
      </div>
      <div class="lg:col-span-8" data-reveal="0.1">
        {faqs.map((f) => (
          <details open class="group border-b border-navy/15 py-5 first:border-t">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-display text-[1.35rem] leading-snug text-navy-900 [&::-webkit-details-marker]:hidden">
              {f.q}
              <span aria-hidden="true" class="grid h-8 w-8 shrink-0 place-items-center rounded-full border border-navy/25 text-navy transition-transform duration-300 group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 max-w-2xl text-slate">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
    <script type="application/ld+json" set:html={ld}></script>
  </section>

  <!-- Book -->
  <section id="book" class="py-20 md:py-24">
    <div class="wrap grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5" data-reveal>
        <p class="eyebrow">Book a visit</p>
        <h2 class="heading-xl mt-4 !text-[clamp(2.2rem,4vw,3.4rem)]">See a podiatrist in <em class="text-sky">{c.city}.</em></h2>
        <p class="mt-4 text-slate">Send us a request and our {c.city} team will call you to set a time. Or call us now.</p>
        <a href={phoneHref} class="mt-6 block font-display text-[2.4rem] text-navy hover:text-sky">{c.phone}</a>
        <p class="mt-2 text-slate">{c.address}, {c.zip}</p>
      </div>
      <div class="rounded-[1.75rem] bg-white p-6 shadow-[0_30px_60px_-40px_rgba(7,31,48,.45)] ring-1 ring-line sm:p-10 lg:col-span-7" data-reveal="0.1">
        <ContactForm client:visible clinics={cityNames} reasons={reasons} />
      </div>
    </div>
  </section>

  <!-- Other clinics -->
  <section class="bg-mist py-16 md:py-20">
    <div class="wrap">
      <p class="eyebrow" data-reveal>Other clinics</p>
      <ul class="mt-5 flex flex-wrap gap-2" data-reveal="0.05">
        {clinics.filter((x) => x.slug !== c.slug).map((x) => (
          <li><a href={`/locations/${x.slug}`} class="inline-block rounded-full border border-navy/15 bg-white px-4 py-2 text-[0.9rem] font-medium text-navy-900 transition-colors hover:border-navy hover:bg-navy hover:text-white">{x.city}</a></li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
