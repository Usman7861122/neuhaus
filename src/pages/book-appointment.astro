---
import PageLayout from "@/layouts/PageLayout.astro";
import { site, providers, unsplash } from "@/data/site";
import { providerDetails } from "@/data/provider-details";
import { clinics } from "@/data/treatments";

const cards = clinics.map((c) => ({
  ...c,
  doctors: providers.filter((p) => providerDetails[p.slug]?.offices.includes(c.slug)),
}));
---
<PageLayout
  title="Book an Appointment"
  description="Choose your Neuhaus Foot & Ankle clinic and book online. 15 clinics across Middle Tennessee."
  eyebrow="Book online"
  heading="Pick your clinic and book."
  intro="Choose the clinic closest to you, then pick a doctor and a time on our secure booking page. Prefer to talk? Call 615-857-5428."
  image={unsplash("1758691462878-6edc3d3da1be", 2000)}
>
  <section class="bg-mist py-16 md:py-24">
    <div class="wrap">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-slate">15 clinics. Booking opens in a new tab.</p>
        <button id="near" type="button" class="btn-navy self-start">Find the clinic nearest me</button>
      </div>
      <p id="near-msg" class="mt-3 min-h-6 text-[0.9rem] text-slate" aria-live="polite"></p>

      <ul id="clinics" class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {cards.map((c) => (
          <li data-lat={c.lat} data-lng={c.lng} data-name={c.city} class="flex flex-col rounded-3xl bg-white p-7 shadow-[0_30px_60px_-45px_rgba(7,31,48,.5)] ring-1 ring-line">
            <p class="near-badge hidden w-fit rounded-full bg-gold/20 px-3 py-1 text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-navy-900">Nearest to you</p>
            <h2 class="mt-2 font-display text-[2rem] leading-tight text-navy-900">{c.city}</h2>
            <p class="mt-2 text-[0.95rem] text-slate">{c.address}<br />{c.zip}</p>
            <a href={`tel:${c.phone.replace(/-/g, "")}`} class="mt-2 w-fit text-[0.95rem] font-semibold text-navy hover:text-sky">{c.phone}</a>
            {c.doctors.length > 0 && (
              <p class="mt-4 text-[0.85rem] text-slate"><span class="font-semibold text-navy-900">Doctors:</span> {c.doctors.map((d) => `Dr. ${d.name.split(" ").slice(-1)[0]}`).join(", ")}</p>
            )}
            <div class="mt-auto flex flex-wrap gap-2 pt-6">
              {c.book ? (
                <a href={c.book} target="_blank" rel="noopener" class="btn-gold !px-6 !py-3 !text-[0.85rem]">Book now</a>
              ) : (
                <a href={`tel:${c.phone.replace(/-/g, "")}`} class="btn-gold !px-6 !py-3 !text-[0.85rem]">Call to book</a>
              )}
              <a href={`/locations/${c.slug}`} class="btn-outline !px-5 !py-3 !text-[0.85rem]">Clinic details</a>
            </div>
          </li>
        ))}
      </ul>

      <p class="mt-12 text-center text-[0.95rem] text-slate">Not sure where to go, or have a question? <a href="/#contact" class="font-semibold text-navy hover:text-sky">Send us a message</a> or call <a href={site.phoneHref} class="font-semibold text-navy hover:text-sky">{site.phone}</a>.</p>
    </div>
  </section>

  <script is:inline>
    (function () {
      var btn = document.getElementById("near"), msg = document.getElementById("near-msg"), list = document.getElementById("clinics");
      if (!btn || !list) return;
      function km(a, b, c, d) { var r = Math.PI / 180, x = (c - a) * r, y = (d - b) * r, h = Math.sin(x / 2) ** 2 + Math.cos(a * r) * Math.cos(c * r) * Math.sin(y / 2) ** 2; return 12742 * Math.asin(Math.sqrt(h)); }
      btn.addEventListener("click", function () {
        if (!navigator.geolocation) { msg.textContent = "Your browser cannot share your location. Please pick a clinic below."; return; }
        msg.textContent = "Looking for the nearest clinic...";
        navigator.geolocation.getCurrentPosition(function (pos) {
          var items = Array.prototype.slice.call(list.children);
          items.forEach(function (li) { li._d = km(pos.coords.latitude, pos.coords.longitude, +li.dataset.lat, +li.dataset.lng); });
          items.sort(function (a, b) { return a._d - b._d; }).forEach(function (li, i) { list.appendChild(li); li.querySelector(".near-badge").classList.toggle("hidden", i !== 0); });
          msg.textContent = "Nearest: " + items[0].dataset.name + " (about " + Math.round(items[0]._d * 0.621) + " miles).";
          list.scrollIntoView({ behavior: "smooth", block: "start" });
        }, function () { msg.textContent = "We could not get your location. Please pick a clinic below."; }, { timeout: 8000 });
      });
    })();
  </script>
</PageLayout>
