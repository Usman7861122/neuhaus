---
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";
import PageLayout from "@/layouts/PageLayout.astro";
import { unsplash, blogImage } from "@/data/site";
import { formatDate } from "@/lib/format";
import { pageSchema } from "@/lib/schema";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getCollection("blog")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return paginate(posts, { pageSize: 12 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const pageNums = Array.from({ length: page.lastPage }, (_, i) => i + 1);
const blogPath = page.currentPage === 1 ? "/blog/" : `/blog/${page.currentPage}/`;
const blogSchema = pageSchema("CollectionPage", page.currentPage > 1 ? `Blog, page ${page.currentPage}` : "Blog", blogPath, undefined,
  page.currentPage === 1 ? [{ name: "Home", path: "/" }, { name: "Blog", path: "/blog/" }] : [{ name: "Home", path: "/" }, { name: "Blog", path: "/blog/" }, { name: `Page ${page.currentPage}`, path: blogPath }]);
const href = (n: number) => (n === 1 ? "/blog/" : `/blog/${n}/`);
---
<PageLayout
  schema={blogSchema}
  title={page.currentPage > 1 ? `Blog, page ${page.currentPage}` : "Blog"}
  description={page.currentPage > 1 ? `Foot and ankle health articles from Neuhaus Foot & Ankle podiatrists. Page ${page.currentPage} of ${page.lastPage} of the blog.` : "Foot and ankle health articles from Neuhaus Foot & Ankle podiatrists: heel pain, bunions, diabetic foot care, toenails, running injuries and more."}
  eyebrow="From the blog"
  heading="Foot health, in plain words."
  intro="Simple advice from our podiatrists to help you walk, run, and live with less pain."
  image={unsplash("1590333748338-d629e4564ad9", 2000)}
>
  <section class="py-20 md:py-28">
    <div class="wrap grid gap-x-8 gap-y-14 md:grid-cols-2 lg:grid-cols-3">
      {page.data.map((p, i) => (
        <a href={`/blog/${p.id}/`} class="group" data-reveal={(i % 3) * 0.08}>
          <div class="overflow-hidden rounded-2xl bg-mist">
            <img src={blogImage(p.data.image, 900, 640)} alt="" loading="lazy" class="aspect-[7/5] w-full object-cover transition-transform duration-[1.2s] ease-[var(--ease-step)] group-hover:scale-[1.05]" />
          </div>
          <p class="mt-6 text-[0.75rem] font-semibold uppercase tracking-[0.16em] text-sky-ink">{p.data.category} &nbsp;/&nbsp; {formatDate(p.data.date)}</p>
          <h2 class="mt-3 font-display text-[2rem] leading-[1.05] group-hover:text-navy">{p.data.title}</h2>
          <p class="mt-3 text-slate">{p.data.excerpt}</p>
        </a>
      ))}
    </div>

    {page.lastPage > 1 && (
      <nav aria-label="Blog pages" class="wrap mt-16 flex flex-wrap items-center justify-center gap-2">
        {page.url.prev !== undefined && <a href={href(page.currentPage - 1)} rel="prev" class="rounded-full border border-line px-5 py-2.5 text-sm font-semibold text-navy hover:bg-mist">&larr; Newer</a>}
        {pageNums.map((n) => (
          <a href={href(n)} aria-current={n === page.currentPage ? "page" : undefined}
            class={`flex h-10 w-10 items-center justify-center rounded-full text-sm font-semibold ${n === page.currentPage ? "bg-navy text-white" : "text-navy hover:bg-mist"}`}>{n}</a>
        ))}
        {page.url.next !== undefined && <a href={href(page.currentPage + 1)} rel="next" class="rounded-full border border-line px-5 py-2.5 text-sm font-semibold text-navy hover:bg-mist">Older &rarr;</a>}
      </nav>
    )}
  </section>
</PageLayout>
