---
import ConditionDetail from "@/components/sections/ConditionDetail.astro";
import { conditions } from "@/data/conditions";
export function getStaticPaths() {
  return conditions.map((c) => ({ params: { slug: c.slug }, props: { slug: c.slug } }));
}
const { slug } = Astro.props;
---
<ConditionDetail slug={slug} />
