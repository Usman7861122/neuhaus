---
import PageLayout from "@/layouts/PageLayout.astro";
import { site } from "@/data/site";
const items = [
  { t: "Patient portal", d: "See visit notes, message your care team, and manage appointments.", href: site.patientPortal, cta: "Open the portal" },
  { t: "Pay your bill", d: "Pay securely online with the details on your statement.", href: site.payOnline, cta: "Pay online" },
  { t: "Insurance", d: "See the plans we accept, or call us to check your coverage.", href: "/#insurance", cta: "View insurance" },
];
---
<PageLayout title="Patient Resources" eyebrow="Patients" heading="Everything you need before your visit.">
  <section class="py-20 md:py-28">
    <div class="wrap grid gap-6 md:grid-cols-3">
      {items.map((i) => (
        <div class="flex flex-col rounded-2xl bg-mist p-8">
          <h2 class="font-display text-3xl">{i.t}</h2>
          <p class="mt-3 text-slate">{i.d}</p>
          <a href={i.href} class="btn-navy mt-8 self-start" {...(i.href.startsWith("http") ? { target: "_blank", rel: "noopener" } : {})}>{i.cta}</a>
        </div>
      ))}
    </div>
  </section>
</PageLayout>
