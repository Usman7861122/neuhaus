---
import PageLayout from "@/layouts/PageLayout.astro";
import ProviderCard from "@/components/ui/ProviderCard.astro";
import { providers, unsplash } from "@/data/site";
import { pageSchema } from "@/lib/schema";
const doctorsSchema = [
  ...pageSchema("CollectionPage", "Our Providers", "/doctors/", "Meet the board-certified podiatrists and foot and ankle surgeons of Neuhaus Foot & Ankle.", [{ name: "Home", path: "/" }, { name: "Our Providers", path: "/doctors/" }]),
  { "@context": "https://schema.org", "@type": "ItemList", itemListElement: providers.map((p, i) => ({ "@type": "ListItem", position: i + 1, url: `https://www.neufoot.com/doctors/${p.slug}/`, name: `Dr. ${p.name}` })) },
];
---
<PageLayout
  schema={doctorsSchema}
  title="Our Providers"
  eyebrow="Our team"
  heading="Meet all 16 of our foot & ankle specialists."
  intro="Board-certified podiatrists, fellowship-trained foot and ankle surgeons, and certified wound specialists, working across 15 clinics in Middle Tennessee."
  image={unsplash("1758691462878-6edc3d3da1be", 2000)}
>
  <section class="bg-mist py-20 md:py-28">
    <div class="wrap">
      <div class="grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {providers.map((p, i) => <ProviderCard {...p} index={i} level={2} />)}
      </div>
      <div class="mt-20 grid gap-6 border-t border-line pt-10 text-[0.9rem] text-slate md:grid-cols-3">
        <p><strong class="text-navy-900">DPM</strong> Doctor of Podiatric Medicine</p>
        <p><strong class="text-navy-900">FACFAS / AACFAS</strong> Fellow / Associate of the American College of Foot and Ankle Surgeons</p>
        <p><strong class="text-navy-900">CWSP</strong> Certified Wound Specialist Physician</p>
      </div>
    </div>
  </section>
</PageLayout>
