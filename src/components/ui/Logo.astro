---
/** Neuhaus Foot & Ankle logo: the official transparent PNG, shown exactly as provided. */
interface Props {
  tone?: "light" | "dark";
  class?: string;
  showTagline?: boolean;
}
const { tone = "dark", class: cls = "" } = Astro.props;
const src = tone === "light" ? "/images/neuhaus-logo-light.png" : "/images/neuhaus-logo.png";
---
<img
  src={src}
  alt="Neuhaus Foot & Ankle"
  width="720"
  height="231"
  class={`block h-12 w-auto sm:h-14 ${cls}`}
  decoding="async"
/>
