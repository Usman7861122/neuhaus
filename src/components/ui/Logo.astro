---
/**
 * Neuhaus Foot & Ankle logo, redrawn as a crisp SVG mark + live-text wordmark.
 * The mark keeps the original idea: a house with two footprints inside.
 */
interface Props {
  tone?: "light" | "dark";
  class?: string;
  showTagline?: boolean;
}
const { tone = "dark", class: cls = "", showTagline = false } = Astro.props;
const id = `lg-${Math.random().toString(36).slice(2, 8)}`;
const top = tone === "light" ? "text-white" : "text-navy";
const bottom = tone === "light" ? "text-white/75" : "text-slate";
const rule = tone === "light" ? "bg-white/40" : "bg-sky";
---
<span class={`inline-flex items-center gap-3 ${cls}`}>
  <svg viewBox="0 0 64 64" class="h-11 w-11 shrink-0" aria-hidden="true">
    <defs>
      <linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#6fb0d6" />
        <stop offset="1" stop-color="#105179" />
      </linearGradient>
    </defs>
    <path d="M32 3 L61 28 H54 V61 H10 V28 H3 Z" fill={`url(#${id})`} />
    <g fill="#fff">
      <g transform="translate(24 42) rotate(-12) scale(1.15)">
        <path d="M0 -6 C4 -6 5 -2 4.5 3 C4 8 3 12 0 12 C-3 12 -3.6 8 -3.6 4 C-3.6 -1 -4 -6 0 -6Z" />
        <circle cx="2.7" cy="-9.6" r="2.1" /><circle cx="-0.4" cy="-10.5" r="1.45" />
        <circle cx="-2.8" cy="-9.8" r="1.2" /><circle cx="-4.5" cy="-8.3" r="1" /><circle cx="-5.6" cy="-6.4" r="0.85" />
      </g>
      <g transform="translate(40.5 33) rotate(12) scale(-1.15 1.15)">
        <path d="M0 -6 C4 -6 5 -2 4.5 3 C4 8 3 12 0 12 C-3 12 -3.6 8 -3.6 4 C-3.6 -1 -4 -6 0 -6Z" />
        <circle cx="2.7" cy="-9.6" r="2.1" /><circle cx="-0.4" cy="-10.5" r="1.45" />
        <circle cx="-2.8" cy="-9.8" r="1.2" /><circle cx="-4.5" cy="-8.3" r="1" /><circle cx="-5.6" cy="-6.4" r="0.85" />
      </g>
    </g>
  </svg>
  <span class="flex flex-col leading-none">
    <span class={`font-display text-[1.55rem] font-semibold tracking-[0.34em] ${top}`}>NEUHAUS</span>
    <span class={`my-[5px] h-px w-full ${rule}`}></span>
    <span class={`text-[0.62rem] font-bold tracking-[0.3em] ${bottom}`}>FOOT &amp; ANKLE</span>
    {showTagline && <span class={`mt-2 text-[0.6rem] tracking-[0.12em] ${bottom}`}>PODIATRISTS ACROSS MIDDLE TENNESSEE</span>}
  </span>
</span>
