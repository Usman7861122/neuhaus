---
/** Neuhaus Foot & Ankle logo: the official transparent PNG, shown exactly as provided. */
interface Props {
  tone?: "light" | "dark";
  class?: string;
  showTagline?: boolean;
}
const { tone = "dark", class: cls = "" } = Astro.props;
const src = tone === "light" ? "/images/logo-header-light.webp" : "/images/logo-header.webp";
---
<img
  src={src}
  alt="Neuhaus Foot & Ankle"
  width="360"
  height="116"
  class={`block h-12 w-auto sm:h-14 ${cls}`}
  decoding="async"
/>
