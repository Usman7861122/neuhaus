---
interface Props { name: string; creds: string; role: string; photo: string; slug: string; index?: number }
const { name, creds, role, photo, slug, index = 0 } = Astro.props;
const initials = name.split(" ").map((p) => p[0]).join("");
---
<article class="group relative" data-reveal={(index % 3) * 0.08}>
  <div class="gable relative aspect-[4/5] overflow-hidden bg-gradient-to-br from-sky-soft to-mist">
    {photo ? (
      <img src={photo} alt={`Dr. ${name}`} loading="lazy" class="h-full w-full object-cover object-top transition-transform duration-[1.2s] ease-[var(--ease-step)] group-hover:scale-[1.05]" />
    ) : (
      <div class="grid h-full w-full place-items-center">
        <span class="font-display text-[6rem] italic text-navy/70">{initials}</span>
      </div>
    )}
    <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-navy-950/40 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"></div>
  </div>
  <h3 class="mt-6 font-display text-[1.9rem] leading-tight"><a href={`/doctors/${slug}`} class="after:absolute after:inset-0 after:content-[''] hover:text-sky focus-visible:outline-2 focus-visible:outline-offset-4">Dr. {name}</a></h3>
  <p class="mt-1 text-[0.78rem] font-semibold uppercase tracking-[0.16em] text-sky">{creds}</p>
  <p class="mt-2 text-[0.95rem] text-slate">{role}</p>
  <p class="mt-3 text-[0.82rem] font-semibold uppercase tracking-[0.14em] text-navy">View profile &rarr;</p>
</article>
