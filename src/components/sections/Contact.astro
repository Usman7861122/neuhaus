---
import { site } from "@/data/site";
const rows = [
  { label: "Call us", value: site.phone, href: site.phoneHref },
  { label: "Fax", value: site.fax },
];
---
<section id="contact" class="bg-white pb-36 pt-20 md:pt-24">
  <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-6">
      <p class="eyebrow" data-reveal>Contact us</p>
      <h2 class="heading-xl mt-5" data-reveal="0.05">Let's get you <em class="text-sky">walking easy.</em></h2>
      <p class="mt-6 max-w-md text-slate" data-reveal="0.1">
        Book online at the clinic closest to you, or call us and our team will find a time that works.
      </p>

      <dl class="mt-10 divide-y divide-line border-y border-line" data-reveal="0.15">
        {rows.map((r) => (
          <div class="flex items-baseline justify-between gap-6 py-4">
            <dt class="text-[0.72rem] font-semibold uppercase tracking-[0.2em] text-sky">{r.label}</dt>
            <dd class="font-display text-[1.6rem] leading-none text-navy-900">
              {r.href ? <a href={r.href} class="hover:text-sky">{r.value}</a> : r.value}
            </dd>
          </div>
        ))}
      </dl>

      <div class="mt-8 flex flex-wrap gap-3" data-reveal="0.2">
        <a href={site.patientPortal} target="_blank" rel="noopener" class="btn-outline !py-3">Patient portal</a>
        <a href="#locations" class="link-arrow ml-2">Find a clinic on the map <span aria-hidden="true">&rarr;</span></a>
      </div>
    </div>

    <div class="lg:col-span-6" data-reveal="0.1">
      <div class="rounded-[1.75rem] bg-mist p-8 sm:p-12">
        <p class="font-display text-[2.2rem] leading-tight text-navy-900">Book your visit online</p>
        <p class="mt-3 text-slate">Pick your clinic, choose a doctor, and select a time. It takes about two minutes.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/book-appointment" class="btn-gold">Choose a clinic and book</a>
          <a href={site.phoneHref} class="btn-outline">Call {site.phone}</a>
        </div>
      </div>
    </div>
  </div>
</section>
