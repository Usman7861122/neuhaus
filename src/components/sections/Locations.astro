---
import { locations, slugify } from "@/data/site";

const clinics = [...locations]
  .sort((a, b) => a.city.localeCompare(b.city))
  .map((l) => ({ ...l, slug: slugify(l.city) }));
const hub = clinics.find((c) => c.city === "Nashville")!;
const mapSrc = (l: { address: string; zip: string }) =>
  `https://www.google.com/maps?q=${encodeURIComponent(`Neuhaus Foot & Ankle, ${l.address}, ${l.zip}`)}&z=15&output=embed`;
const dirUrl = (l: { address: string; zip: string }) =>
  `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(`${l.address}, ${l.zip}`)}`;
---
<section id="locations" class="relative overflow-hidden bg-mist py-20 md:py-24">
  <div class="wrap">
    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div>
        <p class="eyebrow" data-reveal>Our locations</p>
        <h2 class="heading-xl mt-5" data-reveal="0.05">16 clinics across <em class="text-sky">Middle Tennessee.</em></h2>
      </div>
      <p class="max-w-sm text-slate" data-reveal="0.1">Pick a city to see the map, address, and phone number.</p>
    </div>

    <!-- City chips -->
    <ul class="mt-10 flex flex-wrap gap-2" role="list" data-reveal="0.1">
      {clinics.map((c) => (
        <li>
          <button type="button" data-clinic={c.slug} aria-pressed={c.slug === hub.slug ? "true" : "false"}
            class="loc-chip rounded-full border border-navy/15 bg-white px-4 py-2 text-[0.85rem] font-medium text-navy-900 transition-colors duration-300 hover:border-navy">
            {c.city}
          </button>
        </li>
      ))}
    </ul>

    <!-- Map -->
    <div class="relative mt-8 rounded-[1.75rem] bg-white p-4 shadow-[0_30px_60px_-40px_rgba(7,31,48,.45)] sm:p-8" data-reveal="0.15">
    <div>
      <iframe id="loc-map" title="Map of Neuhaus Foot &amp; Ankle clinics" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen class="relative z-0 block h-[380px] w-full rounded-2xl border-0 md:h-[500px]"
        src={mapSrc(hub)} data-srcs={JSON.stringify(Object.fromEntries(clinics.map((c) => [c.slug, mapSrc(c)])))}></iframe>
    </div>

      <!-- Info card -->
      <div id="loc-card" class="mt-6 rounded-2xl bg-navy px-7 py-6 text-white" aria-live="polite">
        {clinics.map((c) => (
          <div data-card={c.slug} class={`${c.slug === hub.slug ? "flex" : "hidden"} flex-col gap-5 md:flex-row md:items-center md:justify-between`}>
            <div class="md:flex md:items-center md:gap-10">
            <div>
            <p class="text-[0.72rem] font-semibold uppercase tracking-[0.22em] text-gold">Neuhaus Foot &amp; Ankle</p>
            <p class="mt-1 font-display text-[2.1rem] leading-tight text-white">{c.city}</p>
            </div>
            <p class="mt-2 text-[0.95rem] text-white/75 md:mt-0 md:border-l md:border-white/15 md:pl-10">{c.address}<br />{c.zip}</p>
            </div>
            <div class="flex flex-wrap gap-2">
              <a href={`tel:${c.phone.replace(/-/g, "")}`} class="btn-ghost !px-5 !py-2.5 !text-[0.85rem]">{c.phone}</a>
              <a href={dirUrl(c)} target="_blank" rel="noopener" class="btn-gold !px-5 !py-2.5 !text-[0.85rem]">Get directions</a>
              <a href={`/locations/${c.slug}`} class="btn-ghost !px-5 !py-2.5 !text-[0.85rem]">Clinic page</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .loc-chip[aria-pressed="true"] { background: var(--color-navy); border-color: var(--color-navy); color: #fff; }
</style>

<script>
  const map = document.getElementById("loc-map") as HTMLIFrameElement | null;
  if (map) {
    const srcs: Record<string, string> = JSON.parse(map.dataset.srcs || "{}");
    const chips = [...document.querySelectorAll<HTMLButtonElement>(".loc-chip")];
    const cards = [...document.querySelectorAll<HTMLElement>("[data-card]")];
    function select(slug: string) {
      if (!srcs[slug]) return;
      if (map!.src !== srcs[slug]) map!.src = srcs[slug];
      chips.forEach((c) => c.setAttribute("aria-pressed", String(c.dataset.clinic === slug)));
      cards.forEach((c) => { const on = c.dataset.card === slug; c.classList.toggle("hidden", !on); c.classList.toggle("flex", on); });
    }
    chips.forEach((c) => c.addEventListener("click", () => select(c.dataset.clinic!)));
    // Clinic chosen from a link (?clinic=brentwood)
    const wanted = new URLSearchParams(location.search).get("clinic");
    if (wanted) select(wanted);
  }
</script>
