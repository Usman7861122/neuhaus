---
import { insurances, site } from "@/data/site";
---
<section id="insurance" class="relative overflow-hidden bg-navy-950 py-20 text-white md:py-24">
  <div class="wrap relative grid gap-10 md:grid-cols-12 md:items-end">
    <div class="md:col-span-7">
      <p class="eyebrow !text-gold" data-reveal>Insurance</p>
      <h2 class="heading-xl mt-5 !text-white" data-reveal="0.05">Insurances <em class="text-sky-soft">we accept.</em></h2>
    </div>
    <div class="md:col-span-5" data-reveal="0.1">
      <p class="text-white/70">
        We work with most major plans, including Medicare and TennCare. Don't see your plan? Call us at{" "}<a href={site.phoneHref} class="font-semibold text-gold hover:underline">{site.phone}</a> and we'll check your coverage before your visit.
      </p>
    </div>
  </div>

  <div class="wrap relative mt-14">
    <ul class="grid grid-cols-2 border-l border-t border-white/10 sm:grid-cols-3 lg:grid-cols-4">
      {insurances.map((name) => (
        <li class="group relative flex min-h-[5.5rem] items-center justify-center border-b border-r border-white/10 px-4 py-6 text-center transition-colors duration-500 hover:bg-white/[0.06]">
          <span class="absolute left-3 top-3 h-2 w-2 border-l border-t border-gold/0 transition-colors duration-500 group-hover:border-gold"></span>
          <span class="font-display text-[clamp(1.15rem,1.6vw,1.5rem)] leading-tight text-white/90">{name}</span>
        </li>
      ))}
      <li class="flex min-h-[5.5rem] items-center justify-center border-b border-r border-white/10 bg-gold/10 px-4 py-6 text-center">
        <a href={site.phoneHref} class="font-display text-[clamp(1.15rem,1.6vw,1.5rem)] italic leading-tight text-gold hover:underline">And many more</a>
      </li>
    </ul>
  </div>
</section>
