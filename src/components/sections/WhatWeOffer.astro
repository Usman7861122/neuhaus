---
import { getCollection } from "astro:content";
import ServiceCard from "@/components/ui/ServiceCard.astro";
const services = (await getCollection("services"))
  .filter((s) => s.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);
---
<section id="services" class="bg-mist py-20 md:py-24">
  <div class="wrap">
    <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end">
      <div>
        <p class="eyebrow" data-reveal>What we offer</p>
        <h2 class="heading-xl mt-5 max-w-2xl" data-reveal="0.05">Care for every part of the <em class="text-sky">foot and ankle.</em></h2>
      </div>
      <div class="max-w-sm" data-reveal="0.1">
        <p class="text-slate">Hover or tap a card to learn more. We treat 70 conditions in 8 groups, from the everyday to the complex.</p>
        <a href="/services" class="link-arrow mt-4">See all services <span aria-hidden="true">&rarr;</span></a>
      </div>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((s, i) => (
        <ServiceCard title={s.data.title} excerpt={s.data.excerpt} image={s.data.image} href={`/services/${s.id}`} index={i} />
      ))}
    </div>
  </div>
</section>
