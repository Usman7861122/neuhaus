---
import TestimonialSlider from "@/components/react/TestimonialSlider";
import { testimonials, unsplash } from "@/data/site";
---
<section id="testimonials" class="py-20 md:py-24">
  <div class="wrap grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5">
      <p class="eyebrow" data-reveal>Testimonials</p>
      <h2 class="heading-xl mt-5" data-reveal="0.05">In our <em class="text-sky">patients'</em> words.</h2>
      <div class="relative mt-10 hidden overflow-hidden rounded-2xl lg:block" data-reveal="0.1">
        <img src={unsplash("1758691462858-f1286e5daf40", 900, 560)} alt="A podiatrist listening to an older patient" loading="lazy" class="aspect-[16/10] w-full object-cover" />
        <p class="absolute bottom-4 left-4 rounded-full bg-white/90 px-4 py-2 text-[0.8rem] font-semibold text-navy backdrop-blur">Reviews from Google, Yelp &amp; Facebook</p>
      </div>
    </div>
    <div class="relative lg:col-span-7">
      <span aria-hidden="true" class="pointer-events-none absolute -left-4 -top-16 font-display text-[16rem] leading-none text-mist select-none">&ldquo;</span>
      <div class="relative">
        <TestimonialSlider client:visible items={testimonials} />
      </div>
    </div>
  </div>
</section>
