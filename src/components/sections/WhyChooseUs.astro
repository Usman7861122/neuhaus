---
const steps = [
  { title: "Book close to home", body: "With 16 clinics from Clarksville to Cookeville, there is a Neuhaus office near where you live or work. One phone number books them all." },
  { title: "See a board-certified podiatrist", body: "Every visit is with a doctor who focuses only on the foot and ankle. Several of our doctors are fellowship-trained surgeons and certified wound specialists." },
  { title: "Get answers on day one", body: "Modern equipment in our offices helps us find the cause of your pain during your first visit, so treatment can start right away." },
  { title: "A plan that fits your life", body: "We start with the simplest care that works. If surgery is the best option, our own foot and ankle surgeons take care of you." },
  { title: "Stay on your feet", body: "Follow-up visits, custom orthotics, and simple home care help keep the problem from coming back. We care for the whole family, kids included." },
];
const foot = `<path d="M0 -6 C4 -6 5 -2 4.5 3 C4 8 3 12 0 12 C-3 12 -3.6 8 -3.6 4 C-3.6 -1 -4 -6 0 -6Z"/><circle cx="2.7" cy="-9.6" r="2.1"/><circle cx="-0.4" cy="-10.5" r="1.45"/><circle cx="-2.8" cy="-9.8" r="1.2"/><circle cx="-4.5" cy="-8.3" r="1"/><circle cx="-5.6" cy="-6.4" r="0.85"/>`;
---
<section id="why" class="relative overflow-hidden bg-navy py-24 text-white md:py-36">
  <svg viewBox="0 0 64 64" aria-hidden="true" class="pointer-events-none absolute -left-24 top-24 h-[34rem] w-[34rem] text-white/[0.03]"><path fill="currentColor" d="M32 3 L61 28 H54 V61 H10 V28 H3 Z"/></svg>

  <div class="wrap relative">
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow !text-gold" data-reveal>Why choose us</p>
      <h2 class="heading-xl mt-5 !text-white" data-reveal="0.05">Your path to <em class="text-sky-soft">walking easy.</em></h2>
      <p class="mt-6 text-white/70" data-reveal="0.1">What a visit with us looks like, from the first call to the last follow-up.</p>
    </div>

    <ol id="walk" class="relative mx-auto mt-20 max-w-5xl">
      <!-- The trail -->
      <span aria-hidden="true" class="absolute bottom-0 left-6 top-0 w-px border-l border-dashed border-white/20 md:left-1/2"></span>
      <span aria-hidden="true" id="walk-line" class="absolute bottom-0 left-6 top-0 w-[2px] -translate-x-[0.5px] origin-top bg-gold md:left-1/2" style="transform: scaleY(0)"></span>

      {steps.map((s, i) => {
        const right = i % 2 === 1;
        return (
          <li class="relative grid grid-cols-[3rem_1fr] gap-6 pb-16 last:pb-0 md:grid-cols-[1fr_5rem_1fr] md:gap-0">
            <!-- Footprint on the trail, alternating left and right foot -->
            <span class="relative z-10 col-start-1 row-start-1 flex justify-center md:col-start-2">
              <span data-step class="grid h-14 w-14 place-items-center rounded-full bg-navy-900 ring-1 ring-gold/40">
                <svg viewBox="-9 -14 18 28" class="h-9 w-9 text-gold" aria-hidden="true">
                  <g fill="currentColor" transform={right ? "scale(-1 1) rotate(10)" : "rotate(-10)"} set:html={foot} />
                </svg>
              </span>
            </span>

            <span aria-hidden="true" data-step-num class={`pointer-events-none col-start-3 row-start-1 hidden self-center font-display text-[7rem] italic leading-none text-white/[0.08] md:block ${right ? "md:col-start-1 md:pr-10 md:text-right" : "md:pl-10"}`}>0{i + 1}</span>
            <div
              data-step-card={right ? "right" : "left"}
              class={`col-start-2 row-start-1 ${right ? "md:col-start-3 md:pl-10" : "md:col-start-1 md:pr-10 md:text-right"}`}
            >
              <p class="text-[0.72rem] font-semibold uppercase tracking-[0.22em] text-gold">Step {i + 1}</p>
              <h3 class="mt-2 font-display text-[clamp(1.8rem,3vw,2.5rem)] leading-[1.05] text-white">{s.title}</h3>
              <p class={`mt-3 max-w-md text-white/70 ${right ? "" : "md:ml-auto"}`}>{s.body}</p>
            </div>
          </li>
        );
      })}
    </ol>
  </div>
</section>

<script>
  import { animate, inView, scroll } from "motion";
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const walk = document.getElementById("walk");
  const line = document.getElementById("walk-line");

  if (reduce) {
    if (line) line.style.transform = "scaleY(1)";
  } else if (walk && line) {
    // The gold trail fills in as you scroll
    scroll(animate(line, { transform: ["scaleY(0)", "scaleY(1)"] }, { ease: "linear" }), {
      target: walk,
      offset: ["start 70%", "end 60%"],
    });

    // Each footprint "stamps" down, then its card slides in
    walk.querySelectorAll("li").forEach((li) => {
      const stamp = li.querySelector<HTMLElement>("[data-step]");
      const card = li.querySelector<HTMLElement>("[data-step-card]");
      if (!stamp || !card) return;
      const fromX = card.dataset.stepCard === "right" ? 40 : -40;
      const isMobile = window.matchMedia("(max-width: 767px)").matches;
      stamp.style.opacity = "0";
      card.style.opacity = "0";
      inView(li, () => {
        animate(stamp, { opacity: [0, 1], transform: ["scale(1.6) rotate(-20deg)", "scale(1) rotate(0deg)"] }, { duration: 0.55, ease: [0.34, 1.56, 0.64, 1] });
        animate(card, { opacity: [0, 1], transform: [`translateX(${isMobile ? 24 : fromX}px)`, "translateX(0px)"] }, { duration: 0.9, delay: 0.15, ease: [0.22, 1, 0.36, 1] });
      }, { margin: "0px 0px -25% 0px" });
    });
  }
</script>
