---
import "@/styles/global.css";
import SEO from "@/components/common/SEO.astro";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import { site } from "@/data/site";

interface Props { title?: string; description?: string; overlayHeader?: boolean; schema?: Record<string, unknown> | Record<string, unknown>[] }
const { title, description, overlayHeader = false, schema } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <SEO title={title} description={description} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body class="pb-[4.5rem] md:pb-0">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[80] focus:rounded-full focus:bg-gold focus:px-5 focus:py-3 focus:text-navy-950">Skip to content</a>
    <Header overlay={overlayHeader} />
    <main id="main"><slot /></main>
    <Footer />
    <!-- Sticky call and book buttons, mobile only -->
    <nav aria-label="Quick actions" class="fixed inset-x-0 bottom-0 z-[60] grid grid-cols-2 gap-2 border-t border-white/10 bg-navy-950/95 px-3 pt-2.5 shadow-[0_-12px_30px_-12px_rgba(7,31,48,.55)] backdrop-blur md:hidden" style="padding-bottom: max(0.625rem, env(safe-area-inset-bottom));">
      <a href={site.phoneHref} class="flex items-center justify-center gap-2 rounded-full border border-white/25 py-3 text-[0.82rem] font-semibold uppercase tracking-[0.12em] text-white">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>
        Call
      </a>
      <a href="/book-appointment" class="flex items-center justify-center gap-2 rounded-full bg-gold py-3 text-[0.82rem] font-semibold uppercase tracking-[0.12em] text-navy-950">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
        Book now
      </a>
    </nav>
    <script>
      // Simple scroll reveal for any element with data-reveal
      import { inView, animate } from "motion";
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      document.querySelectorAll<HTMLElement>("[data-reveal]").forEach((el) => {
        if (reduce) return;
        const delay = Number(el.dataset.reveal || 0);
        el.style.opacity = "0";
        el.style.transform = "translateY(28px)";
        inView(el, () => {
          animate(el, { opacity: 1, transform: "translateY(0px)" }, { duration: 0.9, delay, ease: [0.22, 1, 0.36, 1] });
        }, { margin: "0px 0px -10% 0px" });
      });
    </script>
  </body>
</html>
