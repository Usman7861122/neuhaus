---
import PageLayout from "./PageLayout.astro";
import { site } from "@/data/site";
interface Props { title: string; description: string; updated?: string }
const { title, description, updated = "November 5, 2026" } = Astro.props;
const links = [
  { href: "/privacy-policy", label: "Privacy Policy" },
  { href: "/notice-of-privacy-practices", label: "Notice of Privacy Practices" },
  { href: "/terms", label: "Terms of Use" },
  { href: "/accessibility", label: "Accessibility" },
  { href: "/non-discrimination", label: "Non-Discrimination" },
];
const path = Astro.url.pathname.replace(/\/$/, "");
---
<PageLayout title={title} heading={title} eyebrow="Legal" description={description}>
  <section class="wrap grid gap-12 py-16 md:py-20 lg:grid-cols-12">
    <aside class="lg:col-span-3">
      <nav aria-label="Legal pages" class="lg:sticky lg:top-28">
        <p class="text-[0.72rem] font-semibold uppercase tracking-[0.22em] text-sky">Legal</p>
        <ul class="mt-4 space-y-1 text-[0.95rem]">
          {links.map((l) => (
            <li>
              <a href={l.href} aria-current={path === l.href ? "page" : undefined}
                class={`block rounded-lg px-3 py-2 ${path === l.href ? "bg-mist font-semibold text-navy" : "text-slate hover:bg-mist hover:text-navy"}`}>{l.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </aside>
    <article class="prose-content max-w-3xl lg:col-span-9">
      <p class="!text-[0.9rem] !text-slate/80">Last updated: {updated}</p>
      <slot />
      <h2>Contact us</h2>
      <p>
        Questions about this page? Call us at <a class="underline" href={site.phoneHref}>{site.phone}</a>,
        fax <span>{site.fax}</span>, or visit any of our <a class="underline" href="/locations">15 offices</a>.
        You can also ask for our Privacy Officer at any office.
      </p>
    </article>
  </section>
</PageLayout>
