---
import BaseLayout from "./BaseLayout.astro";
import { pageSchema } from "@/lib/schema";
interface Props { title: string; description?: string; eyebrow?: string; heading?: string; intro?: string; image?: string; schema?: Record<string, unknown> | Record<string, unknown>[] }
const { title, description, eyebrow, heading, intro, image, schema: given } = Astro.props;
// Pages that do not pass their own schema get WebPage (or CollectionPage for index pages) plus breadcrumbs.
const path = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const isIndex = path === "/locations/" || path === "/services/";
const schema = given ?? pageSchema(isIndex ? "CollectionPage" : "WebPage", title, path, description ?? intro, [{ name: "Home", path: "/" }, { name: title, path }]);
---
<BaseLayout title={`${title} | Neuhaus Foot & Ankle`} description={description ?? intro} schema={schema}>
  <section class="relative overflow-hidden bg-navy-950 pb-20 pt-44 text-white md:pb-28 md:pt-52">
    {image && <img src={image} alt="" class="absolute inset-0 h-full w-full object-cover opacity-30" />}
    <div class="absolute inset-0 bg-gradient-to-t from-navy-950 via-navy-950/70 to-navy-950/30"></div>
    <div class="wrap relative">
      {eyebrow && <p class="eyebrow !text-gold">{eyebrow}</p>}
      <h1 class="mt-4 max-w-4xl font-display text-[clamp(2.8rem,7vw,6rem)] text-white">{heading ?? title}</h1>
      {intro && <p class="mt-6 max-w-2xl text-lg text-white/75">{intro}</p>}
    </div>
  </section>
  <slot />
  <div class="h-32" aria-hidden="true"></div>
</BaseLayout>
